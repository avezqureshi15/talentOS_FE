# Google OAuth
VITE_GOOGLE_CLIENT_ID=

# Local dev:            http://localhost:8001
# Production (proxy):   "" (empty — same origin via nginx)
VITE_API_BASE_URL=http://localhost:8001

# Local dev:            http://localhost:8001/api/v1
# Production (proxy):   /api/v1 (relative — nginx forwards to BE)
VITE_BE_API_BASE_URL=http://localhost:8001/api/v1

# Application URL
# Local dev:   http://localhost:5173
# Production:  http://<linode-public-ip>
VITE_APP_URL=http://localhost:5173

# Application environment: development | uat | production
# UAT must behave like development (slot bounds, etc.)
VITE_APP_ENV=development

# Slot duration in minutes
VITE_SLOT_DURATION_MINUTES=30

# AI scan animation toggle
VITE_AI_SCAN_ANIMATION=false
